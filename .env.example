# Copy to .env and adjust. Every variable is optional: the defaults run the
# full pipeline offline with the OpenCV detector and the deterministic mock VLM.

# --- Application ------------------------------------------------------------
SHELF_ENVIRONMENT=local            # local | staging | production | test
SHELF_DEBUG=false
SHELF_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
SHELF_LOG_JSON=false               # forced on outside local

# --- Computer vision --------------------------------------------------------
# 'heuristic' needs no weights. 'yolo' uses an SKU-110K checkpoint fetched on
# first use. 'hybrid' runs YOLO and falls back to OpenCV when it finds too little.
SHELF_DETECTOR_BACKEND=heuristic   # heuristic | yolo | hybrid
# Default: hf:chistopat/sku110k-yolo11-object-detector/weights/sku110k-yolo11-s640.pt
# Accepts a local path, an Ultralytics asset name, or an hf:<owner>/<repo>/<path> spec.
# SHELF_YOLO_WEIGHTS=
# SHELF_YOLO_WEIGHTS_DIR=~/.cache/smart-shelf-analytics/weights
SHELF_DETECTION_CONFIDENCE=0.15
SHELF_ROW_MERGE_TOLERANCE=0.6    # vertical merging tolerance for shelf rows
SHELF_PREPROCESS_MAX_EDGE=1600
SHELF_DETECTION_MAX_ITEMS=600
SHELF_HYBRID_MIN_DETECTIONS=4
SHELF_MAX_IMAGE_BYTES=15728640

# --- Vision language model --------------------------------------------------
SHELF_VLM_BACKEND=mock             # mock | anthropic | openai
SHELF_VLM_MODEL=claude-sonnet-5
SHELF_VLM_MAX_TOKENS=4096
SHELF_VLM_TEMPERATURE=0.0
SHELF_VLM_MAX_RETRIES=2
# SHELF_ANTHROPIC_API_KEY=sk-ant-...
# SHELF_OPENAI_API_KEY=sk-...

# --- Observability (Langfuse) ----------------------------------------------
SHELF_LANGFUSE_ENABLED=false
SHELF_LANGFUSE_HOST=https://cloud.langfuse.com
# SHELF_LANGFUSE_PUBLIC_KEY=pk-lf-...
# SHELF_LANGFUSE_SECRET_KEY=sk-lf-...

# --- Front end -------------------------------------------------------------
# Where the UI looks for the one-click demo shelves. The default resolves
# relative to the source tree, so containers must set it explicitly.
# SHELF_SAMPLE_DATA_DIR=/app/data/sample_data

# --- Persistence ------------------------------------------------------------
SHELF_DATABASE_URL=sqlite+aiosqlite:///./data/audits.db

# --- Autonomous agent -------------------------------------------------------
SHELF_COMPLIANCE_ALERT_THRESHOLD=0.80
SHELF_CRITICAL_OOS_THRESHOLD=3
SHELF_NOTIFICATIONS_DRY_RUN=true   # set false to actually post to the webhooks
# SHELF_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# SHELF_EMAIL_WEBHOOK_URL=https://api.example.com/hooks/email
